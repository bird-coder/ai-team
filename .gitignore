# Codex writes runtime data under .runtime; version only orchestration sources.
/.runtime/
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/USAGE.md
!/config.toml
!/agents/
!/workflows/
!/templates/
!/scripts/
!/tests/
!/skills/
# Codex bootstraps bundled skills here; they are runtime-managed.
/skills/.system/
.DS_Store
__pycache__/
